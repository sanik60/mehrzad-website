---
// A photo when one is set, otherwise the coloured placeholder.
// Photos named "*-1600.webp" also have -480 and -960 versions, so phones
// download a small file and large screens a sharp one.
interface Props {
  art: string;
  image?: string;
  alt?: string;
  banner?: boolean;
  /** Fill the parent instead of keeping its own shape (used inside tiles and heroes). */
  fill?: boolean;
  sizes?: string;
  /** Load immediately (above-the-fold images). */
  eager?: boolean;
}
const { art, image, alt = '', banner = false, fill = false, sizes, eager: eagerProp = false } = Astro.props;
const cls = fill ? 'art-fill' : banner ? 'detail-banner' : 'card-art';
const srcset =
  image && /-1600\.webp$/.test(image)
    ? [480, 960, 1600].map((w) => `${image.replace(/-1600\.webp$/, `-${w}.webp`)} ${w}w`).join(', ')
    : undefined;
const sz = sizes ?? (banner || fill ? '100vw' : '(min-width: 1180px) 380px, (min-width: 640px) 50vw, 100vw');
const eager = banner || eagerProp;
---
<div class={`${cls} ${image ? 'has-photo' : `art-${art}`}`}>
  {image && (
    <img
      src={image}
      srcset={srcset}
      sizes={sz}
      alt={alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      fetchpriority={eager ? 'high' : undefined}
    />
  )}
  <slot />
</div>
