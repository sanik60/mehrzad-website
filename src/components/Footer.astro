---
import { href, useT, type Lang } from '../i18n';
import { site, whatsappLink } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>{site.brand}</strong>
      <p>{t('home.subtitle')}</p>
    </div>
    <ul>
      <li><a href={href(lang, 'tours')}>{t('nav.tours')}</a></li>
      <li><a href={href(lang, 'hotels')}>{t('nav.hotels')}</a></li>
      <li><a href={href(lang, 'destinations')}>{t('nav.destinations')}</a></li>
      <li><a href={href(lang, 'services')}>{t('nav.services')}</a></li>
    </ul>
    <ul>
      <li><a href={href(lang, 'health-tourism')}>{t('nav.health')}</a></li>
      <li><a href={href(lang, 'blog')}>{t('nav.blog')}</a></li>
      <li><a href={href(lang, 'about')}>{t('nav.about')}</a></li>
      <li><a href={href(lang, 'contact')}>{t('nav.contact')}</a></li>
    </ul>
    <ul>
      <li><a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a></li>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={href(lang, 'tours/tailor-made')}>{t('cta.tailor')}</a></li>
    </ul>
  </div>
  <div class="container footer-bottom">© {year} {site.brand}. {t('footer.rights')}</div>
</footer>
