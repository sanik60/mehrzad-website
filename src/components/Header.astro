---
import { languages, langs, href, useT, type Lang } from '../i18n';
import { site, whatsappLink } from '../config';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const t = useT(lang);

const nav = [
  { key: 'nav.tours', path: 'tours' },
  { key: 'nav.hotels', path: 'hotels' },
  { key: 'nav.destinations', path: 'destinations' },
  { key: 'nav.services', path: 'services' },
  { key: 'nav.health', path: 'health-tourism' },
  { key: 'nav.blog', path: 'blog' },
] as const;

const section = path.split('/')[0];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={href(lang)}>
      <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="#0f5c5c" /><path d="M7 22 13 11l4 7 3-4 5 8Z" fill="#f2b84b" /></svg>
      <span>{site.brand}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label={t('nav.menu')}><span></span></label>

    <nav class="main-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={href(lang, item.path)} aria-current={section === item.path ? 'page' : undefined}>{t(item.key)}</a></li>
        ))}
      </ul>
      <div class="header-tools">
        <details class="lang-switch">
          <summary aria-label={t('nav.language')}>🌐 {lang.toUpperCase()}</summary>
          <ul>
            {langs.map((l) => (
              <li><a href={href(l, path)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{languages[l].name}</a></li>
            ))}
          </ul>
        </details>
        <a class="btn btn-wa btn-sm" href={whatsappLink()} target="_blank" rel="noopener">{t('cta.whatsapp')}</a>
      </div>
    </nav>
  </div>
</header>
