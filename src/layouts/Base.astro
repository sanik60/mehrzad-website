---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, langs, href, useT, type Lang } from '../i18n';
import { site, whatsappLink } from '../config';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path without the language prefix, e.g. "tours/classic-persia" */
  path?: string;
  schema?: object | object[];
  /** For pages that exist only once (404): no canonical, no language alternates. */
  noindex?: boolean;
}

const { lang, title, description, path = '', schema, noindex = false } = Astro.props;
const t = useT(lang);
const dir = languages[lang].dir;
const abs = (l: Lang) => new URL(href(l, path), Astro.site).href;
const fullTitle = path ? `${title} | ${site.brand}` : `${site.brand} | ${title}`;
const rtl = dir === 'rtl';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={abs(lang)} />
        {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(l)} />)}
        <link rel="alternate" hreflang="x-default" href={abs('en')} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={lang} />
    <meta name="theme-color" content="#0f5c5c" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    {rtl && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;800&display=swap" />
      </>
    )}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class={rtl ? 'rtl' : ''}>
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    {site.demoContent && <div class="demo-bar">{t('demo.notice')}</div>}
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label={t('cta.whatsapp')}>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4ZM12 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm0-21.6A11.8 11.8 0 0 0 1.8 17.9L.2 23.8l6-1.6A11.8 11.8 0 1 0 12 .2Z"/></svg>
    </a>
  </body>
</html>
