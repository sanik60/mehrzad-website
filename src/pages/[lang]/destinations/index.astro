---
import Base from '../../../layouts/Base.astro';
import { href, pick, useT, langs, type Lang } from '../../../i18n';
import { destinations } from '../../../data/destinations';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---
<Base lang={lang} title={t('dest.title')} description={t('dest.intro')} path="destinations">
  <section class="container page-head">
    <h1>{t('dest.title')}</h1>
    <p class="lead">{t('dest.intro')}</p>
  </section>
  <section class="container section-tight">
    <div class="grid">
      {destinations.map((d) => (
        <article class="card">
          <div class={`card-art art-${d.slug}`} aria-hidden="true"></div>
          <div class="card-body">
            <h3><a href={href(lang, `destinations/${d.slug}`)}>{pick(d.name, lang)}</a></h3>
            <p>{pick(d.summary, lang)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>
