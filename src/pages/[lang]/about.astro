---
import Base from '../../layouts/Base.astro';
import { href, useT, langs, type Lang } from '../../i18n';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---
<Base lang={lang} title={t('about.title')} description={t('about.text').slice(0, 155)} path="about">
  <section class="container page-head narrow">
    <h1>{t('about.title')}</h1>
    <p class="lead">{t('about.text')}</p>
    <div class="grid">
      <div class="feature"><span class="icon">🧭</span><h3>{t('home.why1.title')}</h3><p>{t('home.why1.text')}</p></div>
      <div class="feature"><span class="icon">🛂</span><h3>{t('home.why2.title')}</h3><p>{t('home.why2.text')}</p></div>
      <div class="feature"><span class="icon">💬</span><h3>{t('home.why3.title')}</h3><p>{t('home.why3.text')}</p></div>
    </div>
    <p class="actions"><a class="btn" href={href(lang, 'contact')}>{t('nav.contact')}</a></p>
  </section>
</Base>
