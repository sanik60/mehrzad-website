---
// Root URL: send visitors to the English home page.
const target = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/en/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <meta name="robots" content="noindex" />
  </head>
  <body><a href={target}>Continue</a></body>
</html>
